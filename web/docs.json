{
  "$schema": "https://holocron.so/docs.json",
  "name": "Fleet",
  "description": "Personal apps on your own computers, open from every device on your tailnet.",
  "logo": { "light": "/fleet-light.svg", "dark": "/fleet-dark.svg" },
  "favicon": "/favicon.svg",
  "colors": { "primary": "#a873fa", "dark": "#6d3fd1", "light": "#a873fa" },
  "appearance": { "default": "dark", "strict": false },
  "fonts": {
    "family": "Geist",
    "heading": {
      "family": "Geist Pixel Square",
      "source": "/fonts/GeistPixel-Square.woff2",
      "format": "woff2"
    }
  },
  "icons": { "library": "lucide" },
  "assistant": { "enabled": false },
  "search": { "prompt": "Search Fleet docs…" },
  "navbar": {
    "links": [
      { "label": "Docs", "href": "/docs/overview" },
      { "type": "github", "href": "https://github.com/extoci/fleet" }
    ],
    "primary": { "type": "button", "label": "Get started", "href": "/docs/quickstart" }
  },
  "navigation": {
    "groups": [
      { "group": "Start here", "pages": ["index", "docs/overview", "docs/quickstart"] },
      { "group": "Build with Fleet", "pages": ["docs/apps", "docs/agents", "docs/data-and-jobs"] },
      { "group": "Your devices", "pages": ["docs/networking", "docs/iphone", "docs/computers"] },
      { "group": "Reference", "pages": ["docs/cli", "docs/security", "docs/troubleshooting"] }
    ]
  },
  "footer": { "socials": { "github": "https://github.com/extoci/fleet" } },
  "redirects": [{ "source": "/docs", "destination": "/docs/overview" }]
}
