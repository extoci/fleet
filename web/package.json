{
  "name": "@extoci/fleet-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": "^22.16.0"
  },
  "scripts": {
    "dev": "bun --bun vite --configLoader native --host 0.0.0.0",
    "build": "bun --bun vite build --configLoader native",
    "build:vercel": "VERCEL=1 bun --bun vite build --configLoader native",
    "start": "node dist/rsc/index.js",
    "check": "bun scripts/check-content.mjs",
    "typecheck": "bun check --no-script",
    "lint": "bun lint --no-script",
    "lint:fix": "bun lint --no-script --fix",
    "format": "bun fmt --no-script",
    "format:check": "bun fmt --no-script --check",
    "test": "bun test scripts",
    "test:production": "node scripts/check-production.mjs",
    "test:vercel": "node scripts/check-vercel.mjs"
  },
  "dependencies": {
    "@holocron.so/vite": "0.39.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    }
  },
  "license": "MIT"
}
